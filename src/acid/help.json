{
  "title": "Acid",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Two generative acid",
        "sequencers, blended",
        "into one output.",
        "",
        "Both run on Move's",
        "clock continuously.",
        "",
        "Play a note to set",
        "the shared root."
      ]
    },
    {
      "title": "Quick Start",
      "lines": [
        "1) Insert Acid in a",
        " MIDI FX slot.",
        "2) Route to a synth.",
        "3) Press Play.",
        "4) Play a note to",
        " set the key."
      ]
    },
    {
      "title": "Sequencer A / B",
      "lines": [
        "Generate: fresh",
        "reroll from a new",
        "seed.",
        "Mutate: nudge ~25%",
        "of the steps.",
        "Density/Accent/",
        "Slide: per-step",
        "probabilities.",
        "Octaves: pitch",
        "range, 1-3.",
        "Length: 2-32 steps.",
        "Gate: note length,",
        "per sequencer."
      ]
    },
    {
      "title": "Global",
      "lines": [
        "Root/Scale: shared",
        "by both sequencers.",
        "Seq B: on/off.",
        "A Algo / B Algo:",
        "1-16, blends a 2nd",
        "generator in.",
        "Blend: crossfade A",
        "<-> B, centre = both.",
        "Reset Both: snap",
        "both to step 1 every",
        "1/2/4/8 bars, or Off",
        "to let differently-",
        "lengthed patterns",
        "drift as a polymeter."
      ]
    },
    {
      "title": "Algo",
      "lines": [
        "1 = classic model:",
        "density/accent/",
        "slide/octave rolls.",
        "16 = mostly a 2nd,",
        "urn + random-walk",
        "generator with",
        "pyramid-shaped",
        "accents. In between",
        "blends the two."
      ]
    }
  ]
}
